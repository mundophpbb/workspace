{
	"name": "mundophpbb/workspace",
	"type": "phpbb-extension",
	"description": "phpBB Workspace IDE with Extension Database preflight, automatic official phpBB EPV setup/execution, safe fixes and release packaging.",
	"homepage": "https://github.com/mundophpbb/workspace",
	"version": "1.7.5",
	"time": "2026-09-05",
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "Chico Gois",
			"homepage": "https://mundophpbb.com.br",
			"role": "Developer"
		}
	],
	"require": {
		"php": ">=7.4",
		"composer/installers": "^1.0 || ^2.0"
	},
	"autoload": {
		"psr-4": {
			"mundophpbb\\workspace\\": ""
		}
	},
	"extra": {
		"display-name": "phpBB Workspace IDE",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0"
		},
		"version-check": {
			"host": "mundophpbb.com.br",
			"directory": "/ext/",
			"filename": "workspace.json",
			"ssl": true
		}
	}
}
